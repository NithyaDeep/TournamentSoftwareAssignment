<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.6.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Cameras.Infrastructure/Cameras.Infrastructure.csproj" />
  </ItemGroup>

  <!-- The real dataset, so the supplied data itself is covered by tests. -->
  <ItemGroup>
    <Content Include="../../data/cameras-defb.csv"
             Link="data/cameras-defb.csv"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
